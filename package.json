{
  "name": "tornadt",
  "version": "2.0.0",
  "description": "TornadT — live radar and historical tornado explorer",
  "repository": {
    "type": "git",
    "url": "https://github.com/krgkonekpro04-cpu/TornadT.git"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac dmg zip",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:win:dir": "npm run build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "7.18.4",
    "recharts": "3.10.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "44.9.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "4.3.3",
    "vite": "8.1.5"
  },
  "build": {
    "appId": "com.tornadt.radar",
    "productName": "TornadT",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.weather",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "TornadT-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "electron@44.9.0": true
  }
}
